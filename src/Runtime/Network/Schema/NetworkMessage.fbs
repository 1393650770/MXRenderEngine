// FlatBuffers schema for the network message envelope.
// Every message on the wire is wrapped in a NetworkEnvelope.
// The payload is type-erased [ubyte]; msg_type/rpc_id tell the dispatcher
// how to deserialize it.
//
// Generated by flatc during build:
//   src/Runtime/GenCode/Schema/FlatbufferGen/NetworkMessage_generated.h

namespace MXRender.Network.Message;

enum MessageType : ushort {
    RPC         = 0,
    Replication = 1,
    System      = 2,   // Connect / Disconnect / Heartbeat / ACK
    Spawn       = 3,
    Despawn     = 4,
}

table NetworkEnvelope {
    msg_type:   MXRender.Network.Message.MessageType = RPC;
    rpc_id:     ushort = 0;        // RPC method identifier (RPC type only)
    sequence:   uint = 0;          // Reliability sequence number
    reliable:   bool = true;       // If false, no ACK expected
    payload:    [ubyte];           // Type-erased flatbuffers table bytes
    timestamp:  uint = 0;          // ms, for lag compensation / interpolation
    sender_id:  uint = 0;          // Network endpoint identifier
}

root_type NetworkEnvelope;

// System messages (msg_type = System, rpc_id = 0)
table SystemConnect {
    protocol_version: uint = 1;
    client_id:        uint = 0;    // 0 = request from client, server assigns
}

table SystemDisconnect {
    client_id: uint;
    reason:    ubyte = 0;          // 0=normal, 1=timeout, 2=kicked
}

table SystemHeartbeat {
    client_time: uint;
    server_time: uint = 0;         // 0 = client ping, filled by server pong
}

// Reliability ACK (piggybacked on envelopes or standalone)
table SystemAck {
    ack_sequence: uint;            // Cumulative ACK (all <= ack_sequence received)
    ack_bitmask:  uint = 0;        // Selective ACK for ack_sequence + [1..32]
}
