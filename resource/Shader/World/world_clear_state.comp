#version 460
#extension GL_GOOGLE_include_directive : require
// One-shot init: reset state_a and state_b to all-empty cells.
// (Newly created GPU buffers contain undefined data - must be cleared before
//  the first simulation tick. Matches the Fluid3D GPU one-shot init pattern.)
#include "world_common.glsl"

layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) buffer StateA { uint cells[]; } state_a;
layout(std430, set = 0, binding = 1) buffer StateB { uint cells[]; } state_b;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= WORLD_CELLS)
        return;
    // Empty cell: mat=EMPTY, temp=128 (0 C), life=0, flags=0
    uint empty = pack_cell(MAT_EMPTY, 128u, 0u, 0u);
    state_a.cells[i] = empty;
    state_b.cells[i] = empty;
}
