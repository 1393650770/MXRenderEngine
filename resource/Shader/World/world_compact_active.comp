#version 460
#extension GL_GOOGLE_include_directive : require
// compact_active: builds the active chunk list + clears the claim buffer.
// One thread per chunk. Also writes DispatchIndirect args so the main chain
// can DispatchIndirect over exactly the active chunks (Phase 4).
#include "world_common.glsl"

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) readonly buffer ActiveFlags { uint flags[]; } active_flags;
layout(std430, set = 0, binding = 1) buffer ActiveSlots { uint slots[]; } active_slots;
layout(std430, set = 0, binding = 2) buffer Counter { uint counter; uint pad0; uint pad1; uint pad2; } counter;
layout(std430, set = 0, binding = 3) buffer DrawArgs { uint x; uint y; uint z; } args;
layout(std430, set = 0, binding = 4) buffer Claim { uint claims[]; } claim;

layout(push_constant) uniform PC {
    uint total_chunks;
    uint groups_per_chunk;
    uint world_cells;
    uint _pad;
} pc;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.total_chunks)
        return;

    // Reset claim for this chunk's cells (1 thread per chunk clears its
    // share; total coverage requires total_chunks * cells_per_chunk, so
    // each thread clears a strided subset instead).
    for (uint c = i; c < pc.world_cells; c += pc.total_chunks)
        claim.claims[c] = 0u;

    if (active_flags.flags[i] != 0u)
    {
        uint idx = atomicAdd(counter.counter, 1u);
        active_slots.slots[idx] = i;
    }

    // Last thread writes the dispatch args (fixed max = total_chunks).
    if (i == pc.total_chunks - 1u)
    {
        uint count = counter.counter;
        args.x = count * pc.groups_per_chunk;
        args.y = 1u;
        args.z = 1u;
        counter.counter = 0u;   // reset for next tick
    }
}
