#version 460
#extension GL_GOOGLE_include_directive : require

#include "../Global/GPUScene.glsl"

// GPU culling: frustum test per instance, GPU writes the result straight into
// the indirect draw arguments.
//
// This is the pass that makes the pipeline "GPU-driven": the CPU never learns
// which objects are visible. It submits one indirect command buffer whose
// instanceCount was filled in by a shader.
//
// Two outputs per visible instance:
//   1. atomicAdd on DrawCommands[batchID].instanceCount
//   2. the object id written into the batch's reserved slice of visibleIDs[]
//
// The slice offset comes from GPUBatchData.baseInstance, which is why every
// batch must reserve its max capacity up front.
layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) readonly buffer SceneUniforms { GPUSceneUniformsData u; } g_scene;

// Hi-Z pyramid built by the prepass + gpuscene_hiz.comp: level 0 is full
// resolution and each subsequent level halves.
//
// The levels are five separate textures rather than one mip chain, because this
// RHI has no per-mip texture views. They also get five separate bindings rather
// than a sampler array: the engine's SetResource binds by GLSL instance name and
// does not address array elements.
#define GPU_SCENE_HIZ_LEVELS 5
layout(set = 0, binding = 1) uniform sampler2D g_hiz0;
layout(set = 0, binding = 2) uniform sampler2D g_hiz1;
layout(set = 0, binding = 3) uniform sampler2D g_hiz2;
layout(set = 0, binding = 4) uniform sampler2D g_hiz3;
layout(set = 0, binding = 5) uniform sampler2D g_hiz4;

float HizFetch(int level, ivec2 coord)
{
	if (level == 0) return texelFetch(g_hiz0, coord, 0).x;
	if (level == 1) return texelFetch(g_hiz1, coord, 0).x;
	if (level == 2) return texelFetch(g_hiz2, coord, 0).x;
	if (level == 3) return texelFetch(g_hiz3, coord, 0).x;
	return texelFetch(g_hiz4, coord, 0).x;
}

layout(std430, set = 1, binding = 0) readonly buffer Objects    { GPUObjectData   objects[];    } g_objects;
layout(std430, set = 1, binding = 2) readonly buffer Meshes     { GPUMeshMeta     meshes[];     } g_meshes;
layout(std430, set = 1, binding = 3) buffer         VisibleIDs  { uint            ids[];        } g_visible;
layout(std430, set = 1, binding = 4) readonly buffer Candidates { GPUInstanceData instances[];  } g_candidates;
layout(std430, set = 1, binding = 5) buffer         DrawCommands{ DrawIndexedIndirectArgs cmds[]; } g_commands;
layout(std430, set = 1, binding = 6) readonly buffer Batches    { GPUBatchData    batches[];    } g_batches;

// Frustum planes arrive in world space (xyz = normal, w = offset).
// Signed distance > -radius means the bounds sphere is at least partly inside.
bool FrustumVisible(vec3 center_world, float radius)
{
	for (int i = 0; i < 6; ++i)
	{
		const vec4 plane = g_scene.u.frustumPlanes[i];
		if (dot(plane.xyz, center_world) + plane.w < -radius)
			return false;
	}
	return true;
}

// Occlusion test against the Hi-Z pyramid.
//
// The object's screen-space AABB picks a pyramid level whose texel roughly
// matches the AABB's pixel footprint, so four texel reads cover the whole
// footprint instead of a fixed grid of point samples. That is both cheaper and
// far less likely to miss a thin occluder.
//
// The reduction is MAX, so a level stores the farthest depth in its footprint —
// which means the test can only under-cull. It never removes something visible.
bool OcclusionCulled(vec3 center_world, float radius)
{
	if (g_scene.u.counts.w == 0u)          // occlusion disabled
		return false;
	if (g_scene.u.hizAndDepth.x < 1.0)     // pyramid not ready yet
		return false;

	const vec4 cp = g_scene.u.viewProj * vec4(center_world, 1.0);
	if (cp.w <= 0.0)                       // behind the camera
		return false;

	const vec4 cv = g_scene.u.view * vec4(center_world, 1.0);
	const float view_z = -cv.z;            // the view looks down -Z
	if (view_z <= radius)                  // sphere straddles the eye
		return false;

	// Use the NEAR side of the sphere so the AABB is never smaller than the
	// true footprint — that direction is the conservative one.
	const float near_z = max(view_z - radius, 1e-3);
	const float px = abs(g_scene.u.viewProj[0][0]) * radius / near_z;
	const float py = abs(g_scene.u.viewProj[1][1]) * radius / near_z;

	const vec2 ndc = cp.xy / cp.w;
	vec2 uv_min = (ndc - vec2(px, py)) * 0.5 + 0.5;
	vec2 uv_max = (ndc + vec2(px, py)) * 0.5 + 0.5;
	if (uv_max.x < 0.0 || uv_max.y < 0.0 || uv_min.x > 1.0 || uv_min.y > 1.0)
		return false;                      // entirely off-screen: the frustum test owns this

	uv_min = clamp(uv_min, vec2(0.0), vec2(1.0));
	uv_max = clamp(uv_max, vec2(0.0), vec2(1.0));

	// Level 0's size comes from the uniform (the prepass knew the viewport), and
	// every coarser level is that shifted right by its index.
	const vec2 l0_size = g_scene.u.hizAndDepth.xy;
	const vec2 footprint = (uv_max - uv_min) * l0_size;
	const float extent = max(footprint.x, footprint.y);

	// floor(log2) maps a footprint to the level where it spans ~1 texel.
	const int level = clamp(int(floor(log2(max(extent, 1.0)))), 0, GPU_SCENE_HIZ_LEVELS - 1);

	const vec2 level_size = max(floor(l0_size / exp2(float(level))), vec2(1.0));
	const ivec2 max_coord = ivec2(level_size) - ivec2(1);

	const vec2 lu_min = uv_min * level_size;
	const vec2 lu_max = uv_max * level_size;
	const ivec2 c00 = clamp(ivec2(lu_min), ivec2(0), max_coord);
	const ivec2 c11 = clamp(ivec2(lu_max), ivec2(0), max_coord);
	const ivec2 c10 = clamp(ivec2(lu_max.x, lu_min.y), ivec2(0), max_coord);
	const ivec2 c01 = clamp(ivec2(lu_min.x, lu_max.y), ivec2(0), max_coord);

	// Four texel reads cover the whole footprint at this level.
	float farthest = 0.0;
	farthest = max(farthest, HizFetch(level, c00));
	farthest = max(farthest, HizFetch(level, c11));
	farthest = max(farthest, HizFetch(level, c10));
	farthest = max(farthest, HizFetch(level, c01));

	const float sphere_depth = cp.z / cp.w;
	// Bias so geometry sitting exactly on its own depth is not culled.
	return sphere_depth > farthest + 1e-4;
}

bool IsVisible(uint objectID, vec3 center_world)
{
	const GPUObjectData obj = g_objects.objects[objectID];
	const float radius = obj.sphereBounds.w;

	if (!FrustumVisible(center_world, radius))
		return false;

	// Draw-distance cull. The frustum's far plane already rejects everything
	// past the projection distance, but that is usually far too generous for
	// what you actually want drawn — set hizAndDepth.w below the far plane to
	// drop distant detail. 0 disables it.
	const float max_draw_distance = g_scene.u.hizAndDepth.w;
	if (max_draw_distance > 0.0)
	{
		const float view_z = -(g_scene.u.view * vec4(center_world, 1.0)).z;
		if (view_z - radius > max_draw_distance)
			return false;
	}

	if (OcclusionCulled(center_world, radius))
		return false;
	return true;
}

// Picks the level of detail for an object from its view distance.
//
// Levels are laid out contiguously in meshes[], so the target batch is simply
// `groupBatch + level` — no second indirection. A single-level group always
// resolves to 0, which is why scenes with no LOD assets behave exactly as they
// did before this existed.
//
// Thresholds are geometric (base * step^(k-1)) so the bands stay proportional
// as a scene scales. obj.lodBias shifts the decision per object, which is how a
// "hero" object can be pinned to high detail while its neighbours drop.
uint SelectLOD(const GPUObjectData obj, float view_z)
{
	const uint lod_count = g_meshes.meshes[obj.meshID].lodCount;
	if (lod_count <= 1u)
		return 0u;

	const float bias = obj.lodBias;
	const float base = g_scene.u.lodParams.x;
	const float step = g_scene.u.lodParams.y;

	uint lod = 0u;
	for (uint k = 1u; k < lod_count; ++k)
	{
		const float threshold = base * pow(step, float(k) - 1.0);
		if (view_z + bias > threshold)
			lod = k;
	}
	return lod;
}

void main()
{
	const uint gid = gl_GlobalInvocationID.x;
	if (gid >= g_scene.u.counts.x)   // counts.x = object count
		return;

	const GPUInstanceData inst = g_candidates.instances[gid];
	const GPUObjectData obj = g_objects.objects[inst.objectID];

	const vec3 center_local = obj.sphereBounds.xyz;
	const vec3 center_world = (obj.model * vec4(center_local, 1.0)).xyz;

	// counts.z == 0 keeps everything, so the culled and unculled paths can be
	// compared with the same data and the same draw commands.
	if (g_scene.u.counts.z != 0u && !IsVisible(inst.objectID, center_world))
		return;

	const float view_z = -(g_scene.u.view * vec4(center_world, 1.0)).z;
	const uint lod = SelectLOD(obj, view_z);

	// batchID is the object's LOD group base; the level selects the actual batch.
	const uint batch_index = min(inst.batchID + lod, uint(g_batches.batches.length()) - 1u);
	const GPUBatchData batch = g_batches.batches[batch_index];

	const uint slot = atomicAdd(g_commands.cmds[batch_index].instanceCount, 1u);

	// Guard against overflowing the slice reserved for this batch.
	if (slot < batch.maxInstanceCount)
		g_visible.ids[batch.baseInstance + slot] = inst.objectID;
}
